# LiveKit Voice Agents — Environment Variables
#
# DSGVO-WICHTIG: Default ist Vertex AI in EU-Region für alle LLMs und
# Azure Speech in EU-Region für STT/TTS. Deepgram ist optional als STT-
# Latenz-Alternative — nur nutzen, wenn EU-Endpoint, Zero-Retention und
# DPA/AVV sauber belegt sind.


# ─── DOMAINS (nur für VPS-Produktion, lokal ignoriert) ────────────────────────
APP_DOMAIN=voice.meine-domain.de
LIVEKIT_DOMAIN=lk.meine-domain.de
CADDY_EMAIL=admin@meine-domain.de


# ─── LIVEKIT SERVER (lokal generierte Keys, via scripts/generate-keys.sh) ─────
LIVEKIT_API_KEY=
LIVEKIT_API_SECRET=
# Lokal: ws://localhost:7990  |  VPS: wss://${LIVEKIT_DOMAIN}
LIVEKIT_URL=ws://localhost:7990


# ─── LLM: GOOGLE VERTEX AI (alle Agents) ──────────────────────────────────────
# DSGVO: EU-Region wählen, z.B. europe-west4 (Niederlande) oder europe-west1 (Belgien).
GOOGLE_APPLICATION_CREDENTIALS=/secrets/gcp-sa.json
GOOGLE_CLOUD_PROJECT=deine-project-id
GOOGLE_CLOUD_LOCATION=europe-west4
GEMINI_MODEL=gemini-2.5-flash-lite
GEMINI_TOOL_MODEL=gemini-2.5-flash

# Agent 01 nutzt das Live-API-Modell (Speech-to-Speech, EU-GA in europe-west4).
# Voice-Optionen: Aoede, Puck, Charon, Kore, Fenrir (alle multilingual inkl. DE).
GEMINI_LIVE_MODEL=gemini-live-2.5-flash-native-audio
GEMINI_LIVE_VOICE=Aoede
GEMINI_LIVE_LANGUAGE=de-DE


# ─── SPEECH: AZURE SPEECH (STT + TTS alle Agents) ─────────────────────────────
# DSGVO: Speech-Resource in EU-Region anlegen, z.B. swedencentral,
# germanywestcentral, westeurope oder francecentral.
AZURE_SPEECH_KEY=
AZURE_SPEECH_REGION=swedencentral
AZURE_SPEECH_LANGUAGE=de-DE
AZURE_SPEECH_VOICE=de-DE-Seraphina:DragonHDLatestNeural


# ─── OPTIONAL STT: DEEPGRAM (Latency-Alternative) ─────────────────────────────
# DSGVO: EU-Endpoint nutzen, DPA/AVV abschließen, keine Trainingsnutzung vereinbaren.
DEEPGRAM_API_KEY=
DEEPGRAM_BASE_URL=https://api.eu.deepgram.com
DEEPGRAM_MODEL=nova-3
DEEPGRAM_LANGUAGE=de


# ─── GOOGLE CALENDAR (nur für Agent 02 — Terminbuchung) ───────────────────────
GOOGLE_SERVICE_ACCOUNT_PATH=./secrets/gcp-sa.json
GOOGLE_CALENDAR_ID=primary


# ─── TWILIO SIP (nur für Agent 03 — Outbound-Calls auf VPS) ───────────────────
TWILIO_ACCOUNT_SID=
TWILIO_AUTH_TOKEN=
TWILIO_SIP_TRUNK_URI=sip:<your-trunk-id>.pstn.twilio.com
TWILIO_PHONE_NUMBER=+49...
LIVEKIT_OUTBOUND_TRUNK_ID=
