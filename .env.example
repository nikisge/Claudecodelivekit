# LiveKit Voice Agents — Environment Variables
#
# DSGVO-WICHTIG: Default ist Deepgram EU für Agent 01 STT sowie Azure Speech
# für TTS und Agent 02/03 STT in EU-Regionen.
# Optionale Anbieter wie Deepgram, Cartesia oder ElevenLabs nur nutzen, wenn
# EU-Endpoint/EU-Residency, Zero-Retention und DPA/AVV sauber belegt sind.


# ─── DOMAINS (nur für VPS-Produktion, lokal ignoriert) ────────────────────────
APP_DOMAIN=voice.meine-domain.de
LIVEKIT_DOMAIN=lk.meine-domain.de
CADDY_EMAIL=admin@meine-domain.de


# ─── LIVEKIT SERVER (lokal generierte Keys, via scripts/generate-keys.sh) ─────
LIVEKIT_API_KEY=
LIVEKIT_API_SECRET=
# Lokal: ws://localhost:7990  |  VPS: wss://${LIVEKIT_DOMAIN}
LIVEKIT_URL=ws://localhost:7990


# ─── LLM: AZURE OPENAI (Default für alle Agents) ─────────────────────────────
# DSGVO: "EU Data Zone Standard" deployment wählen, NICHT "Global Standard".
AZURE_OPENAI_API_KEY=
AZURE_OPENAI_ENDPOINT=https://<dein-resource>.openai.azure.com
AZURE_OPENAI_API_VERSION=2024-12-01-preview
AZURE_OPENAI_DEPLOYMENT=gpt-4.1-mini


# ─── SPEECH: AZURE SPEECH (STT + TTS — Default für alle Agents) ──────────────
# DSGVO: Speech-Resource in EU-Region anlegen, z.B. swedencentral,
# germanywestcentral, westeurope oder francecentral.
AZURE_SPEECH_KEY=
AZURE_SPEECH_REGION=swedencentral
AZURE_SPEECH_LANGUAGE=de-DE
AZURE_SPEECH_VOICE=de-DE-SeraphinaMultilingualNeural


# ─── OPTIONAL: GOOGLE VERTEX AI (Agent-01-Alternative für niedrigere LLM-Latenz) ─
# DSGVO: EU-Region wählen, z.B. europe-west4 (Niederlande).
# Wer Vertex nutzen will, muss agent.py von openai.LLM.with_azure auf google.LLM zurückbauen.
GOOGLE_APPLICATION_CREDENTIALS=/secrets/gcp-sa.json
GOOGLE_CLOUD_PROJECT=deine-project-id
GOOGLE_CLOUD_LOCATION=europe-west4
GEMINI_MODEL=gemini-2.5-flash-lite


# ─── OPTIONAL: DEEPGRAM (Agent-01-Alternative für niedrigere STT-Latenz) ─────
# DSGVO: EU-Endpoint nutzen, DPA/AVV abschließen, keine Trainingsnutzung vereinbaren.
DEEPGRAM_API_KEY=
DEEPGRAM_BASE_URL=https://api.eu.deepgram.com
DEEPGRAM_MODEL=nova-3
DEEPGRAM_LANGUAGE=de


# ─── OPTIONAL TTS: CARTESIA ───────────────────────────────────────────────────
# DSGVO: Nur mit Zero-Retention + DPA + bestätigtem EU-Hosting als EU-only verkaufen.
CARTESIA_API_KEY=
CARTESIA_VOICE_ID=


# ─── OPTIONAL TTS: ELEVENLABS ─────────────────────────────────────────────────
# DSGVO: EU Residency ist Enterprise-only und nutzt separaten EU-Workspace/API-Key.
ELEVENLABS_API_KEY=
ELEVEN_VOICE_ID=


# ─── GOOGLE CALENDAR (nur für Agent 02 — Terminbuchung) ───────────────────────
GOOGLE_SERVICE_ACCOUNT_PATH=./secrets/gcp-sa.json
GOOGLE_CALENDAR_ID=primary


# ─── TWILIO SIP (nur für Agent 03 — Outbound-Calls auf VPS) ───────────────────
TWILIO_ACCOUNT_SID=
TWILIO_AUTH_TOKEN=
TWILIO_SIP_TRUNK_URI=sip:<your-trunk-id>.pstn.twilio.com
TWILIO_PHONE_NUMBER=+49...
LIVEKIT_OUTBOUND_TRUNK_ID=
