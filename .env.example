# ──────────────────────────────────────────────────────────────────────────────
# LiveKit Voice Agents — Environment Variables
#
# DSGVO-WICHTIG: Dieses Repo ist darauf ausgelegt, nur mit DSGVO-konformen
# EU-Endpoints zu arbeiten. Achte bei jedem Provider darauf, dass du den
# EU-Region-Endpoint / EU-Data-Zone gewählt hast — nicht den "Global Standard".
# ──────────────────────────────────────────────────────────────────────────────


# ─── DOMAINS (nur für VPS-Produktion, lokal ignoriert) ────────────────────────
APP_DOMAIN=voice.meine-domain.de
LIVEKIT_DOMAIN=lk.meine-domain.de
CADDY_EMAIL=admin@meine-domain.de


# ─── LIVEKIT SERVER (lokal generierte Keys, via scripts/generate-keys.sh) ─────
LIVEKIT_API_KEY=devkey
LIVEKIT_API_SECRET=secret-min-32-zeichen-lang-bitte-ersetzen
# Lokal: ws://localhost:7990  |  VPS: wss://${LIVEKIT_DOMAIN}
LIVEKIT_URL=ws://localhost:7990


# ─── LLM: GOOGLE VERTEX AI (für Agent 01 — Low-Latency) ───────────────────────
# DSGVO: europe-west4 (Niederlande) oder europe-west1 (Belgien) als Region wählen.
# Siehe docs/dsgvo-compliance.md zur "Global Processing"-Nuance bei Vertex.
GOOGLE_APPLICATION_CREDENTIALS=/secrets/gcp-sa.json
GOOGLE_CLOUD_PROJECT=mein-gcp-projekt
GOOGLE_CLOUD_LOCATION=europe-west4
GEMINI_MODEL=gemini-2.5-flash-lite


# ─── LLM: AZURE OPENAI (für Agent 02 + 03 — Tool Calling / Lead Qual) ─────────
# DSGVO: "EU Data Zone Standard" deployment wählen, NICHT "Global Standard".
# Region: swedencentral. GPT-4.1-mini ist Default; verifizieren in Azure Portal.
AZURE_OPENAI_API_KEY=
AZURE_OPENAI_ENDPOINT=https://<dein-resource>.openai.azure.com
AZURE_OPENAI_API_VERSION=2024-12-01-preview
AZURE_OPENAI_DEPLOYMENT=gpt-4.1-mini


# ─── STT: DEEPGRAM (für alle Agents) ──────────────────────────────────────────
# DSGVO: EU-Residency wird im Deepgram-Dashboard pro Projekt gesetzt
# (Settings → Region: EU). Es gibt KEINEN eigenen api.eu.deepgram.com Endpoint;
# der globale Endpoint routet automatisch zu EU-Servern, wenn das Projekt EU ist.
DEEPGRAM_API_KEY=
DEEPGRAM_BASE_URL=https://api.deepgram.com/v1/listen


# ─── TTS: CARTESIA (für Agent 01) ─────────────────────────────────────────────
# DSGVO: Zero-Retention-Mode aktiv (per Account-Setting), DPA mit Cartesia unterzeichnet.
# CARTESIA_VOICE_ID: aus dem Sonic Multilingual-Katalog eine DEUTSCHE Stimme wählen.
# Voice Library: https://play.cartesia.ai/voices (nach "German" filtern, Probe anhören)
CARTESIA_API_KEY=
CARTESIA_VOICE_ID=


# ─── TTS: ELEVENLABS (für Agent 02 + 03) ──────────────────────────────────────
# DSGVO: EU Residency aktiviert (nur Enterprise), Zero-Retention via enable_logging=False.
# Default-Voice: "Johanna" (deutsch) — Voice-ID aus ElevenLabs VoiceLab kopieren.
ELEVENLABS_API_KEY=
ELEVEN_VOICE_ID=


# ─── GOOGLE CALENDAR (nur für Agent 02 — Terminbuchung) ───────────────────────
# Siehe docs/google-calendar-setup.md: Service Account anlegen, JSON runterladen,
# Kalender mit der Service-Account-E-Mail teilen (Schreibrechte).
GOOGLE_SERVICE_ACCOUNT_PATH=./secrets/gcp-sa.json
GOOGLE_CALENDAR_ID=primary


# ─── TWILIO SIP (nur für Agent 03 — Outbound-Calls auf VPS) ───────────────────
# Elastic SIP Trunk in Twilio Console anlegen, Origination-URI auf VPS-IP/Domain zeigen.
# Siehe docs/twilio-setup.md.
TWILIO_ACCOUNT_SID=
TWILIO_AUTH_TOKEN=
TWILIO_SIP_TRUNK_URI=sip:<your-trunk-id>.pstn.twilio.com
TWILIO_PHONE_NUMBER=+49...

# LiveKit-seitige SIP-Trunk-ID, wird von scripts/setup-sip.py erstellt und hier eingetragen
LIVEKIT_OUTBOUND_TRUNK_ID=
